POSTGRES_DB=enterprise_data_copilot
POSTGRES_USER=enterprise_app
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SEMANTIC_CACHE_PREFIX=semantic_cache:ask
REDIS_LANGGRAPH_STATE_PREFIX=langgraph:ask
REDIS_CHAT_HISTORY_PREFIX=chat:history

API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

SQL_EXECUTION_TIMEOUT_SECONDS=10
SQL_RESULT_LIMIT=100

SQL_GENERATION_METADATA_LIMIT=8
SQL_GENERATION_RETRY_COUNT=1
CHAT_HISTORY_CONTEXT_LIMIT=6
CHAT_HISTORY_REDIS_TTL_SECONDS=604800
LANGGRAPH_STATE_TTL_SECONDS=86400
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_BUSINESS_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_SECONDS=86400

ELASTICSEARCH_URL=http://localhost:9200

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen2.5:14b
OLLAMA_SQL_MODEL=qwen2.5-coder:14b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

LLM_PROVIDER=gemini
# LLM_PROVIDER=ollama
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change_me_before_real_use
APP_ALLOWED_HOSTS=localhost,127.0.0.1
API_VERSION=v1
LOG_LEVEL=INFO
